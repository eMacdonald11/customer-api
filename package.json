{
  "name": "customer-api-service",
  "version": "0.1.0",
  "private": true,
  "description": "Greenfield B2B Customer API template (Node.js + TypeScript + OpenAPI 3)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:openapi": "redocly lint openapi.yaml",
    "ci": "npm run format:check && npm run lint && npm run typecheck && npm run validate:openapi && npm run test && npm run build"
  },
  "dependencies": {
    "express": "^4.21.2",
    "express-openapi-validator": "^5.4.6"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@eslint/js": "^9.17.0",
    "@redocly/cli": "^1.25.9",
    "@types/express": "^4.17.21",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  }
}
